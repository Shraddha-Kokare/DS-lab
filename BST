//Construct the binary search tree by inserting the values in given order.
//After constructing binary search tree perform following operations
//1) Insert a new node 2) Find numbers of node in longest path 3) Mini-
//mum and maximum data value found in tree 4) Change a tree so that the
//roles of the left and right pointers are swapped at every node 5) Search
//an element

#include <iostream>
#include<stack>
using namespace std;

class BSTNode
{
public:
	int data;
	int level;
	BSTNode* left;
	BSTNode* right;
};

class BSTOperations
{
public:
	BSTNode* createTree(BSTNode* root);
	void showPreOrder(BSTNode* root);
	void showInOrder(BSTNode* root);
	void showPostOrder(BSTNode* root);
	int findHeight(BSTNode* root,int max);
};

BSTNode* BSTOperations::createTree(BSTNode* root)
{
	int count,level,flag;

	cout<<"\nEnter the number of nodes: ";
	cin>>count;

	for(int i=0;i<count;i++)
	{
		BSTNode* newNode=new BSTNode;
		cout<<"\nEnter data for new node: ";
		cin>>newNode->data;

		newNode->left=NULL;
		newNode->right=NULL;

		if(root==NULL)
			root=newNode;
		else{
			BSTNode* parent=root;
			level=0;
			flag=0;

			while(flag!=1)
			{
				if(newNode->data<=parent->data)
				{
					if(parent->left==NULL)
					{
						level++;
						parent->left=newNode;
						newNode->level=level;
						flag=1;
					}
					else
					{
						parent=parent->left;
						level++;
					}
				}
				else
				{
					if(parent->right==NULL)
					{
											level++;
											parent->right=newNode;
											newNode->level=level;
											flag=1;
					}
					else
					{
											parent=parent->right;
											level++;
					}
				}
			}
		}
	}
	return root;
}

void BSTOperations::showPreOrder(BSTNode* root)
{
	stack<BSTNode*> s;

	s.push(root);

	while(!s.empty())
	{
		BSTNode *temp=s.top();
		cout<<temp->data<<" - ";

		s.pop();

		if(temp->right)
			s.push(temp->right);

		if(temp->left)
			s.push(temp->left);
	}
}

void BSTOperations::showInOrder(BSTNode* root)
{
    stack<BSTNode*> s;
    BSTNode* current = root;

    while (current != NULL || !s.empty())
    {
        while (current != NULL)
        {
            s.push(current);
            current = current->left;
        }

        current = s.top();
        s.pop();

        cout << current->data << " - ";

        current = current->right;
    }
}


void BSTOperations::showPostOrder(BSTNode* root)
{
    if (root == NULL)
        return;

    stack<BSTNode*> s;
    BSTNode* current = root;
    BSTNode* prev = NULL;

    while (!s.empty() || current != NULL)
    {
        if (current != NULL)
        {
            s.push(current);
            current = current->left;
        }
        else
        {
            // Peek the node from the stack
            BSTNode* peekNode = s.top();

            // If the right child is null or has been processed already, visit the node
            if (peekNode->right == NULL || peekNode->right == prev)
            {
                cout << peekNode->data << " - ";
                s.pop();
                prev = peekNode; // Mark this node as visited
            }
            else
            {
                // Otherwise, push the right child to the stack
                current = peekNode->right;
            }
        }
    }
}


int BSTOperations::findHeight(BSTNode* root,int max)
{
	stack<BSTNode*> s;

		s.push(root);

		while(!s.empty())
		{
			BSTNode *temp=s.top();
			cout<<endl<<temp->data<<"(level="<<temp->level<<")";
			if(max<temp->data)
				max=temp->level;

			s.pop();

			if(temp->right)
				s.push(temp->right);

			if(temp->left)
				s.push(temp->left);
		}
		return max;
}

int main() {
	int max=0;
	BSTOperations bop;
	BSTNode* newroot=NULL;
	newroot=bop.createTree(newroot);
	bop.showPreOrder(newroot);
	cout<<"\nPostorder: ";
	bop.showPostOrder(newroot);
	cout<<"\nInorder: ";
	bop.showInOrder(newroot);

	int height=bop.findHeight(newroot, max);
	cout<<"\nHeight = "<<height;

	return 0;
}
