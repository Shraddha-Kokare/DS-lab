			}
			else if(val<current->data)
			{
				parent=current;
				current=current->left;
			}
			else{
				parent=current;
				current=current->right;
			}
		}



		if(current==NULL)
		{
			cout<<"\nKey is not present";
		}
		else
		{
			if(current->left==NULL && current->right==NULL)
			{
				BSTNode* del=current;

				if(current==parent->left)
				{
					parent->left=NULL;
				}
				else
				{
					parent->right=NULL;
				}

				delete del;
			}
			else if(current->left!=NULL && current->right!=NULL)
			{
				BSTNode* del=current;

				delete del;
