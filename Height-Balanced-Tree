#include <iostream>
#include <string>
using namespace std;

class Node
{
public:
	int key;
	string value;
	struct Node *left;
	struct Node *right;
	int height;
};

int getHeight(Node *n)
{
	if(n==NULL)
		return 0;
	else
		return n->height;
}

Node* createNode(int key,string val)
{
	Node* newNode;
	newNode->key=key;
	newNode->value=val;
	newNode->left=NULL;
	newNode->right=NULL;
	newNode->height=1;

	return newNode;
}

int getBalanceFactor(Node* n)
{
	if(n==NULL)
		return 0;
	else
	{
		return (getHeight(n->left) - getHeight(n->right));
	}
}

Node* rightRotate(Node *y)
{
	Node* x=y->left;
	Node* T2=x->right;

	x->right=y;
	y->left=T2;

	x->height=max(getHeight(x->left),getHeight(x->right))+1;
	y->height=max(getHeight(y->left),getHeight(y->right))+1;

	return x;
}

Node* leftRotate(Node *x)
{
	Node* y=x->right;
	Node* T2=y->left;


	x->right=y;
	y->left=T2;

	x->height=max(getHeight(x->left),getHeight(x->right))+1;
	y->height=max(getHeight(y->left),getHeight(y->right))+1;

	return x;
}

