section .data
str1 db "Enter string: "
str1len equ $-str1

str2 db "Your entered string: "
str2len equ $-str2

section .bss
res resb 15         ; Buffer for the entered string (max 15 characters)
reslen resb 1       ; Store the length of the entered string (1 byte)

section .text
global _start

_start:
    ; Print prompt: "Enter string: "
    mov rax, 1          ; syscall number for sys_write
    mov rdi, 1          ; file descriptor for stdout
    mov rsi, str1       ; pointer to the "Enter string: " string
    mov rdx, str1len    ; length of the prompt string
    syscall

    ; Read input string from the user
    mov rax, 0          ; syscall number for sys_read
    mov rdi, 0          ; file descriptor for stdin
    mov rsi, res        ; buffer to store the input
    mov rdx, 15         ; maximum number of characters to read
    syscall
    mov [reslen], al    ; store the number of characters read in reslen

    ; Print prompt: "Your entered string: "
    mov rax, 1          ; syscall number for sys_write
    mov rdi, 1          ; file descriptor for stdout
    mov rsi, str2       ; pointer to the "Your entered string: " string
    mov rdx, str2len    ; length of the prompt string
    syscall

    ; Print the entered string
    mov rax, 1          ; syscall number for sys_write
    mov rdi, 1          ; file descriptor for stdout
    mov rsi, res        ; buffer containing the input string
    movzx rdx, byte [reslen]  ; get the length from reslen
    syscall

    ; Print the length of the string
    
    dec rax
    movzx rax, byte [reslen]   ; load the length from reslen
    add rax, '0'               ; convert length to ASCII (assuming it's < 10)
    mov rdi, 1                 ; file descriptor for stdout
    mov rsi, length            ; pointer to the length buffer
    mov [length], al           ; store the ASCII value of the length in 'length'

    mov rax, 1                 ; syscall number for sys_write
    mov rdx, 1                 ; print a single character
    syscall

    ; Exit the program
    mov rax, 60                ; syscall number for sys_exit
    xor rdi, rdi               ; exit status 0
    syscall

section .bss
length resb 1                  ; buffer to store the ASCII representation of the length
